{
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"/opt/toknila/bin/toknila\" hook pre_tool_use",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"/opt/toknila/bin/toknila\" hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"/opt/toknila/bin/toknila\" hook user_prompt_submit",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "mcp__toknila",
      "Read(//w/ships/demo-1/**)"
    ],
    "deny": [
      "Agent",
      "Workflow",
      "EnterWorktree",
      "CronCreate",
      "CronDelete",
      "RemoteTrigger",
      "<deny rules for the private folders of the home>"
    ]
  }
}
