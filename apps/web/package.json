{
  "name": "toknila-web",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript openapi.json -o src/gen/api.d.ts",
    "gen:check": "openapi-typescript openapi.json -o src/gen/api.d.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "11.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.9"
  }
}
